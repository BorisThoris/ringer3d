{
  "name": "ringer3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ringer 3D — a modern take on the classic playground marble game.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "e2e:online": "node scripts/e2e-online.mjs",
    "deploy": "npm run build && node scripts/keep-old-assets.mjs && wrangler deploy",
    "headless:build": "esbuild src/headless/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-headless/ringer-headless.mjs --log-level=warning",
    "headless": "node dist-headless/ringer-headless.mjs",
    "export:roblox": "npm run headless:build && node roblox/scripts/export.mjs",
    "steam:start": "npm run build && npm --prefix steam start",
    "steam:pack": "npm run build && npm --prefix steam run pack"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "trystero": "^0.26.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@gltf-transform/cli": "^4.2.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
