{
  // Cloudflare Worker serving the built web app as static assets.
  // Live at https://ringer3d.modaxxx009.workers.dev. Deploy: `npm run deploy`.
  // Online play is serverless (Nostr + WebRTC), so no backend is needed here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ringer3d",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
